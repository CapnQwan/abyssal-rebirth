# =========================
# Dependencies
# =========================
node_modules/
.pnpm-store/

# =========================
# Build outputs
# =========================
dist/
/build/
/out/
*.tsbuildinfo

# =========================
# Logs
# =========================
logs/
*.log

# =========================
# Environment files
# =========================
.env
.env.local
.env.*.local

# =========================
# OS junk
# =========================
.DS_Store
Thumbs.db

# =========================
# Editors / IDEs
# =========================
.vscode/*
# Shared editor config is committed so everyone gets Biome as the formatter.
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
!.vscode/tasks.json
.idea/

# =========================
# Vite / modern bundlers
# =========================
.vite/
.cache/

# =========================
# Game engine / graphics artifacts
# =========================
# compiled shaders
*.spv
*.glslang
*.wgsl.cache

# GPU / shader compilation caches
shader-cache/
shaders/cache/

# runtime-generated assets (if you stream or bake assets)
runtime-assets/
generated-assets/
/baked/

# =========================
# Monorepo (pnpm)
# =========================
.pnpm-debug.log*

# =========================
# Coverage
# =========================
coverage/

# =========================
# Optional: local tooling state
# =========================
.tmp/
/temp/