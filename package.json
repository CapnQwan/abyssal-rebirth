{
  "name": "@abyssal-rebirth/workspace",
  "version": "0.0.0",
  "description": "A TypeScript based engine built on ECS architecture",
  "license": "MIT",
  "author": "Quin Partridge",
  "private": true,
  "keywords": [
    "games",
    "ecs",
    "game-engine",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CapnQwan/abyssal-rebirth.git"
  },
  "bugs": {
    "url": "https://github.com/CapnQwan/abyssal-rebirth/issues"
  },
  "homepage": "https://github.com/CapnQwan/abyssal-rebirth#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.root.json",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "check": "biome check . --error-on-warnings",
    "check:ci": "biome ci . --error-on-warnings",
    "fix": "biome check . --write",
    "prepare": "husky"
  },
  "packageManager": "pnpm@10.33.4",
  "lint-staged": {
    "*.{ts,tsx,js,json,jsonc}": [
      "biome check --write --error-on-warnings --no-errors-on-unmatched"
    ]
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.13",
    "@cult-frog/tooling": "^0.1.1",
    "@types/node": "^24.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  }
}
