{
  "name": "@abyssal-rebirth/shared",
  "description": "Shared utilities for the engine.",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Quin Partridge",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "@abyssal-rebirth/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "src",
    "dist",
    "!dist/.tsbuildinfo",
    "!src/**/_tests",
    "!dist/**/_tests",
    "!src/**/*.test.ts",
    "!dist/**/*.test.*"
  ],
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
